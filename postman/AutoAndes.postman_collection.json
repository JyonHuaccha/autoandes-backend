            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Auto2026*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"tokenAdmin\", pm.response.json().token);",
                  "pm.test(\"JWT de una hora\", () => pm.expect(pm.response.json().expiraEnSegundos).to.eql(3600));"
